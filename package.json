{
  "name": "marketing-popup-engine",
  "version": "1.1.0",
  "description": "Zero-dependency, declarative marketing pop-up engine driven by HTML data-* attributes.",
  "main": "dist/marketing-popup.min.js",
  "style": "dist/marketing-popup.min.css",
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "popup",
    "modal",
    "marketing",
    "vanilla-js",
    "data-attributes",
    "exit-intent"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild src/marketing-popup.js --bundle --minify --outfile=dist/marketing-popup.min.js && esbuild src/marketing-popup.css --minify --outfile=dist/marketing-popup.min.css"
  }
}
